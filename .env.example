# Backend Settings
PORT=5000
FLASK_ENV=production
SECRET_KEY=datastraw_secure_production_secret_key_change_me
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/datastraw_roster?retryWrites=true&w=majority
DB_NAME=datastraw_roster
CORS_ORIGINS=*

# Frontend Settings (Vite)
VITE_API_BASE_URL=http://localhost:5000/api
